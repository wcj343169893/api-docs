{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-docs",
  "compatibility_date": "2026-06-22",
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "AUTH_USER": "xxx",
    "AUTH_PASS": "xxx"
  },
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}